<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9FB5C2">

    <FrameLayout
        android:id="@+id/innerScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0mm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 游戏层 -->
        <FrameLayout
            android:id="@+id/gameContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- 左上角 SCORE / LIFE -->
        <LinearLayout
            android:id="@+id/layoutLeftInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- SCORE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivScoreLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/img_score_label" />

                <edu.hitsz.widget.DigitTextView
                    android:id="@+id/digitScoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- LIFE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLifeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/img_life_label" />

                <edu.hitsz.widget.DigitTextView
                    android:id="@+id/digitLifeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右上角模式图片 -->
        <ImageView
            android:id="@+id/ivModeValue"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/img_mode_easy" />

        <!-- 左下角本局获得金币 -->
        <LinearLayout
            android:id="@+id/layoutCoinsGot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCoinsGotLabel"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:src="@drawable/img_coins_got_label" />

            <edu.hitsz.widget.DigitTextView
                android:id="@+id/digitCoinsGotValue"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null" />
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>