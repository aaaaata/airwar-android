<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOnlineRoom"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9FB5C2">

    <FrameLayout
        android:id="@+id/innerScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0mm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <edu.hitsz.widget.FlowBackgroundView
            android:id="@+id/flowBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/vBlurMask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66091622" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/onlineRoomContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/panelSelect"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.78"
                app:layout_constraintDimensionRatio="310:208"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/imgSelectPanelBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_online_room_select_panel" />

                <EditText
                    android:id="@+id/etRoomCode"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/bg_room_input"
                    android:gravity="center"
                    android:hint="Room ID for JOIN"
                    android:inputType="number"
                    android:maxLength="6"
                    android:singleLine="true"
                    android:textColor="#111111"
                    android:textColorHint="#888888"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/selectButtonBar"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnJoinRoom"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:padding="0dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/btn_join_room" />

                    <ImageButton
                        android:id="@+id/btnCreateRoom"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:padding="0dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/btn_create_room" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/panelWaiting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintWidth_percent="0.78"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/imgWaitingPanelBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_online_room_waiting_panel" />

                <LinearLayout
                    android:id="@+id/waitingContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="0dp">

                    <ImageView
                        android:id="@+id/ivLobbyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_title_lobby" />

                    <LinearLayout
                        android:id="@+id/roomIdRow"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgRoomIdLabel"
                            android:layout_width="90dp"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_room_id_label" />

                        <edu.hitsz.widget.DigitTextView
                            android:id="@+id/digitRoomCode"
                            android:layout_width="90dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/versusArea"
                        android:layout_width="match_parent"
                        android:layout_height="104dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginTop="8dp">

                        <edu.hitsz.widget.RoundCornerImageView
                            android:id="@+id/ivSelfAvatar"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_avatar_placeholder"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/imgVs"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintHorizontal_chainStyle="spread" />

                        <ImageView
                            android:id="@+id/imgVs"
                            android:layout_width="46dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_vs"
                            app:layout_constraintStart_toEndOf="@id/ivSelfAvatar"
                            app:layout_constraintEnd_toStartOf="@id/ivOpponentAvatar"
                            app:layout_constraintTop_toTopOf="@id/ivSelfAvatar"
                            app:layout_constraintBottom_toBottomOf="@id/ivSelfAvatar" />

                        <edu.hitsz.widget.RoundCornerImageView
                            android:id="@+id/ivOpponentAvatar"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_avatar_placeholder"
                            app:layout_constraintStart_toEndOf="@id/imgVs"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/ivSelfAvatar"
                            app:layout_constraintBottom_toBottomOf="@id/ivSelfAvatar" />

                        <TextView
                            android:id="@+id/tvSelfName"
                            android:layout_width="90dp"
                            android:layout_height="20dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="USER1"
                            android:textColor="#111111"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/ivSelfAvatar"
                            app:layout_constraintStart_toStartOf="@id/ivSelfAvatar"
                            app:layout_constraintEnd_toEndOf="@id/ivSelfAvatar" />

                        <TextView
                            android:id="@+id/tvOpponentName"
                            android:layout_width="100dp"
                            android:layout_height="20dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="WAITING"
                            android:textColor="#111111"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/ivOpponentAvatar"
                            app:layout_constraintStart_toStartOf="@id/ivOpponentAvatar"
                            app:layout_constraintEnd_toEndOf="@id/ivOpponentAvatar" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <ImageButton
                        android:id="@+id/btnStart"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@null"
                        android:contentDescription="@null"
                        android:padding="0dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/btn_ready_normal" />
                </LinearLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
