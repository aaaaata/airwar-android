<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWaitingResult"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9FB5C2">

    <FrameLayout
        android:id="@+id/innerScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0mm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <edu.hitsz.widget.FlowBackgroundView
            android:id="@+id/flowBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/waitingResultContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/panelWaitingResult"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.78"
                app:layout_constraintDimensionRatio="310:208"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/imgWaitingResultPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_waiting_result_panel" />

                <!-- 只显示省略号：左上角位于距离右下角 86dp x 48dp 的位置 -->
                <TextView
                    android:id="@+id/tvWaitingResult"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="43dp"
                    android:gravity="start|center_vertical"
                    android:text="..."
                    android:textColor="#111111"
                    android:textSize="40sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>