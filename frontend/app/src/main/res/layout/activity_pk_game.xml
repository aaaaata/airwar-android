<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9FB5C2">

    <FrameLayout
        android:id="@+id/innerScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0mm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <edu.hitsz.widget.FlowBackgroundView
            android:id="@+id/flowBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/pkBarRoot"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivPkBarBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_pk_bar" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideTop20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.2" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideBottom80"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_percent="0.8" />

                    <!-- 左侧：自己信息 -->
                    <LinearLayout
                        android:id="@+id/leftInfoBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/guideBottom80"
                        app:layout_constraintStart_toStartOf="parent">

                        <edu.hitsz.widget.RoundCornerImageView
                            android:id="@+id/ivMyAvatar"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_avatar_placeholder" />

                        <LinearLayout
                            android:id="@+id/myInfoRows"
                            android:layout_width="122dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical|start"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/rowMyName"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_marginBottom="2dp"
                                android:gravity="center_vertical|start"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivMyLabelUname"
                                    android:layout_width="48dp"
                                    android:layout_height="match_parent"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/img_label_uname" />

                                <TextView
                                    android:id="@+id/tvMyName"
                                    android:layout_width="74dp"
                                    android:layout_height="match_parent"
                                    android:ellipsize="end"
                                    android:gravity="center_vertical|start"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="USER1"
                                    android:textColor="#111111"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/rowMyScore"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_marginBottom="2dp"
                                android:gravity="center_vertical|start"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivMyLabelScore"
                                    android:layout_width="48dp"
                                    android:layout_height="match_parent"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/img_label_score" />

                                <edu.hitsz.widget.DigitTextView
                                    android:id="@+id/digitMyScore"
                                    android:layout_width="74dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical|start" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/rowMyLife"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:gravity="center_vertical|start"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivMyLabelLife"
                                    android:layout_width="48dp"
                                    android:layout_height="match_parent"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/img_label_life" />

                                <edu.hitsz.widget.DigitTextView
                                    android:id="@+id/digitMyLife"
                                    android:layout_width="74dp"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical|start" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 右侧：对手信息 -->
                    <LinearLayout
                        android:id="@+id/rightInfoBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_marginEnd="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toTopOf="@id/guideTop20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <LinearLayout
                            android:id="@+id/enemyInfoRows"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/rowEnemyName"
                                android:layout_width="wrap_content"
                                android:layout_height="12dp"
                                android:layout_marginBottom="1dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivEnemyLabelUname"
                                    android:layout_width="46dp"
                                    android:layout_height="match_parent"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/img_label_uname" />

                                <TextView
                                    android:id="@+id/tvEnemyName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="2dp"
                                    android:ellipsize="end"
                                    android:gravity="center_vertical|start"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:maxWidth="72dp"
                                    android:text="USER2"
                                    android:textColor="#111111"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/rowEnemyScore"
                                android:layout_width="wrap_content"
                                android:layout_height="12dp"
                                android:layout_marginBottom="1dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivEnemyLabelScore"
                                    android:layout_width="46dp"
                                    android:layout_height="match_parent"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/img_label_score" />

                                <edu.hitsz.widget.DigitTextView
                                    android:id="@+id/digitEnemyScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/rowEnemyLife"
                                android:layout_width="wrap_content"
                                android:layout_height="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivEnemyLabelLife"
                                    android:layout_width="46dp"
                                    android:layout_height="match_parent"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="@null"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/img_label_life" />

                                <edu.hitsz.widget.DigitTextView
                                    android:id="@+id/digitEnemyLife"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <edu.hitsz.widget.RoundCornerImageView
                            android:id="@+id/ivEnemyAvatar"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_avatar_placeholder" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/pkGameContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                app:layout_constraintTop_toBottomOf="@id/pkBarRoot"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>